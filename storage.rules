rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Notas fiscais de VT/VR: só PDF, máx 5MB, apenas usuários logados.
    match /nf/{lancId}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
    // NF pendente de processamento: o app envia o PDF aqui e o gatilho
    // processarNFStorage sobe para o Drive e apaga o temporário.
    // Só PDF, máx 10MB, apenas usuários logados. Ninguém lê (só o Admin SDK).
    match /nf-pendentes/{colecao}/{lancId}/{arquivo} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
    // Resto do bucket: negado.
    match /{allPaths=**} { allow read, write: if false; }
  }
}
